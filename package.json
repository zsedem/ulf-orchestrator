{
  "name": "ulf-orchestrator",
  "version": "2.9.2",
  "private": true,
  "description": "AI agent orchestrator with web dashboard",
  "workspaces": [
    "backend/*",
    "frontend/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:server": "npm run build -w @ulf-web/server",
    "build:web": "npm run build -w @ulf-web/dashboard",
    "dev": "npm run dev:web",
    "dev:api": "cargo run -p ulf-api",
    "dev:web": "npm run dev -w @ulf-web/dashboard",
    "dev:legacy-server": "npm run dev -w @ulf-web/server",
    "start": "cargo run -p ulf-api",
    "test": "npm run test --workspaces --if-present",
    "test:server": "npm run test -w @ulf-web/server",
    "clean": "npm run clean --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "ai",
    "agent",
    "orchestrator",
    "ulf"
  ],
  "author": "",
  "license": "MIT"
}
